{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EVE Suite",
  "version": "1.0.0",
  "identifier": "com.eve-suite.desktop",
  "build": {
    "frontendDist": "../packages/ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @eve-suite/ui dev",
    "beforeBuildCommand": "pnpm --filter @eve-suite/ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EVE Suite",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}